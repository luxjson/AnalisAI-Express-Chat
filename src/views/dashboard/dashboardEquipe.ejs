<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <script src="/js/shared/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe — AnalisAI</title>
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
    <script src="/js/shared/phosphor-icons.js" defer></script>
    <link rel="stylesheet" href="/css/base/dashboard.css">
    <link rel="stylesheet" href="/css/pages/team.css">
    <link rel="stylesheet" href="/css/base/light-theme.css">
</head>
<body class="dash-body">

    <div class="team-wrapper">

        <!-- LOGO -->
        <div class="team-logo">
            <img src="/images/logo3-white.png" alt="AnalisAI">
            <h3>Time de Desenvolvimento</h3>
        </div>

        <!-- CARD PRINCIPAL -->
        <div class="team-card">

            <!-- GRID DE MEMBROS -->
            <div class="team-grid">

                <!-- FRONT-END -->
                <div class="team-section">
                    <div class="team-section-title">
                        <i class="ph-bold ph-pencil"></i> Front-end
                    </div>
                    <p>Lucas Eduardo Duarte Pereira</p>
                    <p>Ellefer Fernanda Bovaroti Rizzo</p>
                </div>

                <!-- BACK-END -->
                <div class="team-section">
                    <div class="team-section-title">
                        <i class="ph-bold ph-terminal-window"></i> Back-end
                    </div>
                    <p>Lucas Eduardo Duarte Pereira</p>
                    <p>Isabella Li Affa Sanches</p>
                </div>

                <!-- BANCO DE DADOS -->
                <div class="team-section">
                    <div class="team-section-title">
                        <i class="ph-bold ph-database"></i> Banco de Dados
                    </div>
                    <p>Isabella Li Affa Sanches</p>
                    <p>Luiz Otávio da Silva Mattarugo</p>
                </div>

            </div>

            <!-- DIVISOR / AÇÕES -->
            <div class="team-divider">
                <div class="team-actions">
                    <a href="#" onclick="event.preventDefault(); history.back()" class="btn-secondary-dash">
                        <i class="ph-bold ph-arrow-left"></i> Voltar ao Painel
                    </a>
                    <a href="/dashboard" class="btn-secondary-dash">
                        <i class="ph-bold ph-house"></i> Dashboard
                    </a>
                </div>
            </div>

        </div>

    </div>

</body>
</html>