<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <script src="/js/shared/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Senha</title>
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
    <script src="/js/shared/phosphor-icons.js" defer></script>
    <link rel="stylesheet" href="/css/base/dashboard.css">
    <link rel="stylesheet" href="/css/pages/forgot-password.css">
    <link rel="stylesheet" href="/css/base/light-theme.css">
</head>
<body class="dash-body">

    <div class="login-wrapper">
        <div style="margin-bottom: 20px;">
            <a href="/login" class="btn-secondary-dash" style="text-decoration: none;">
                <i class="fas fa-undo-alt"></i> VOLTAR
            </a>
        </div>

        <div class="login-card">
            <div class="login-logo">
                <img src="/images/logo3-white.png" alt="AnalisAI">
            </div>

            <h2 class="page-title">Recuperar Senha</h2>

            <% if (error_msg && error_msg.length > 0) { %>
                <div class="alert-box error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
            <% } %>
            <% if (success_msg && success_msg.length > 0) { %>
                <div class="alert-box success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
            <% } %>

            <div class="info-box-login">
                <i class="fas fa-info-circle"></i> Informe seu e-mail para solicitar a redefinição da sua senha.
            </div>

            <form action="/esqueci-senha/solicitar" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="input-group">
                    <input type="email" name="email" placeholder="SEU E-MAIL CADASTRADO" oninput="this.value = this.value.toLowerCase()" required>
                </div>
                
                <button type="submit" class="btn-secondary-dash" style="width: 100%;text-align: center;display: flex;justify-content: center;">
                    SOLICITAR REDEFINIÇÃO
                </button>
            </form>

            <p style="text-align: center; margin-top: 25px; color: #555; font-size: 0.8rem;">
                Um administrador será notificado para validar seu pedido.
            </p>
        </div>
        <footer style="margin-top: 30px; text-align: center;">
            <a href="/termos" class="btn-secondary-dash" style="font-size: 0.7rem; border: none; background: transparent;">
                TERMOS DE SERVIÇO
            </a>
        </footer>
    </div>

</body>
</html>