<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <script src="/js/shared/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AnalisAI - Manual do Usuário</title>
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
    <script src="/js/shared/phosphor-icons.js" defer></script>
    <link rel="stylesheet" href="/css/components/sidebar.css">
    <link rel="stylesheet" href="/css/base/dashboard.css">
    <link rel="stylesheet" href="/css/pages/manuals.css">
    <link rel="stylesheet" href="/css/base/light-theme.css">
</head>
<body class="dash-body">

    <% if (userCargo === 'Professor' || userCargo === 'Admin') { %>
    <%- include('partials/barProfessor') %>
    <% } else { %>
        <%- include('partials/barAluno') %>
    <% } %>
    
    <div class="main-layout">
        <header class="dash-header">
            <div class="header-left">
                <h1>
                    Manual do Usuário
                </h1>
            </div>
            
            <div class="header-user">
                <div class="user-profile-group">
                    <div class="user-details">
                        <span class="user-name"><strong><%= user %></strong></span>
                    </div>
                </div>
                <div class="header-actions">
                    <%- include('./partials/notificacoes', { notificacaoClasse: 'header-icon' }) %>
                     
                </div>
            </div>
        </header>

        <main class="cards">
            <div class="card">
                <h1 class="title">
                    Manual do Professor
                </h1>
                <a href="/manuais/professor" id="professorBtn" class="button">
                    
                    Acessar
                </a>
            </div>
            <div class="card">
                <h1 class="title">
                    Manual do Aluno
                </h1>
                <a href="/manuais/aluno" id="alunoBtn" class="button-1">
                    Acessar
                </a>
            </div>
        </main>

    </div>
</body>
</html>